# ==============================================================================
# ATELIER Platform — Environment Configuration
# ==============================================================================

# --- AI Integration (Google Gemini) ---
# Required for AI Artwork Metadata Assistant, AI Bio Assistant, and Commission Briefs.
# Automatically injected in Google AI Studio from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Application Host ---
# Hosted app URL for self-referential links, OAuth redirects, and API endpoints.
APP_URL="http://localhost:3000"

# --- Database & Persistence ---
# PostgreSQL connection string for Prisma & Supabase.
# If omitted or unconfigured during development, the application falls back
# gracefully to the built-in development memory/JSON repository with full seed data.
DATABASE_URL="postgresql://postgres:password@localhost:5432/atelier?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/atelier?schema=public"

# --- Authentication ---
# Secret token used by Auth.js / JWT session signing.
# Generate via: openssl rand -base64 32
AUTH_SECRET="atelier-hackathon-secure-secret-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloud Storage (Artwork Photography) ---
# Practical cloud storage endpoint (Supabase Storage / Cloudinary / S3).
# If unconfigured, the client FileReader Base64 fallback is utilized.
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Email Notifications ---
# Transactional email service (Resend / SendGrid).
# If unconfigured, the built-in simulated in-app notification drawer logs dispatches.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@atelier.app"
